#!/nas/software/miniconda3/bin/Rscript
suppressPackageStartupMessages({
library(argparser)
})

parse <- arg_parser("===================================================================\nThis script is used for Survival analysis of genes.\n===================================================================",hide.opts = T)

parse <- add_argument(parse, "--exp_file", 
    help="Diff gene expression file of DEG results (such as: TCGA-ESCA_supp/DEG/Normal__Tumor/Gene_expr_diff.xls)")
parse <- add_argument(parse, "--meta_file",
    help="Clinical information file containing survival information (such as: TCGA-LUSC_clinical.xls)")
parse <- add_argument(parse, "--gene", default = 'all gene',
    help="The gene used for Survival analyse, If there are multiple genes, separate them with commas")
parse <- add_argument(parse, "--samples", default = 'Tumor',
    help="The sample used for Survival analyse, You can use all samples or just the Tumor sample (Option: 'Tumor' or 'All')")
parse <- add_argument(parse, "--pvalue", default = 0.05,
    help="If the significance of the gene is lower than this value, the survival analysis of the gene is no longer carried out")
parse <- add_argument(parse, "--number", default = 20,
    help="Output the number of Survival analysis pictures.")
parse <- add_argument(parse, "--outdir",
    help="Output directory of this result.default = './TCGA*_supp/Survival/'")

argv <- parse_args(parse)
if(is.na(argv$exp_file)|is.na(argv$meta_file)){cat('\nThe parameters <exp_file> and <meta_file> is required\n\n');print(parse);quit()}
if(!argv$samples %in% c('Tumor', 'All')){cat('\nThe parameters <samples> only can be used [Tumor] or [All]\n\n');print(parse);quit()}
exp_file <- argv$exp_file
meta_file <- argv$meta_file
gene <- argv$gene
samples <- argv$samples
pvalue <- as.numeric(argv$pvalue)
number <- as.numeric(argv$number)

if (!is.na(argv$outdir)) {
  outdir <- argv$outdir
}else if(endsWith(strsplit(exp_file,'/')[[1]][1],'_supp') & is.na(argv$outdir)) {
  outdir <- paste0(strsplit(exp_file,'/')[[1]][1],'/Survival/')
}else if(endsWith(strsplit(exp_file,'/')[[1]][2],'_supp') & is.na(argv$outdir)) {
  outdir <- paste0(strsplit(exp_file,'/')[[1]][2],'/Survival/')
}else{outdir <- './supp/Survival/'}

suppressPackageStartupMessages({
library(survival)
library(survminer)
library(cowplot)
library(table1)
library(tibble)
library(dplyr)
})

