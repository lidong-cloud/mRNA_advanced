#!/nas/software/miniconda3/bin/Rscript
suppressPackageStartupMessages({
library(argparser)
})

parse <- arg_parser("===================================================================\nThis script is used to analyze the single gene prognosis and draw the ROC curve of the gene. If the final number of genes is less than 8, we will draw a general picture.\n===================================================================",hide.opts = T)

parse <- add_argument(parse, "--exp_file", 
    help="DEG result file containing gene expression information (such as: supp/DEG/Normal__Tumor/Gene_expr_diff.xls)")
parse <- add_argument(parse, "--config_file",
    help="config file containing sample information")
parse <- add_argument(parse, "--gene", default = 'all gene',
    help="The gene used for ROC analyse, If there are multiple genes, separate them with commas.")
parse <- add_argument(parse, "--auc", default = 0.7,
    help="The auc cut off for the ROC analyse.")
parse <- add_argument(parse, "--threads", default = 10,
    help="Number of threads that can be used")
parse <- add_argument(parse, "--number", default = 20,
    help="Output the number of single gene ROC curve pictures.")
parse <- add_argument(parse, "--outdir",
    help="Output directory of this result.default = './GSE*_supp/ROC/'")

argv <- parse_args(parse)
if(is.na(argv$exp_file)|is.na(argv$config_file)){cat('\nThe parameters <exp_file> and <config_file> is required\n\n');print(parse);quit()}
exp_file <- argv$exp_file
config_file <- argv$config_file
gene <- argv$gene
auc <- as.numeric(argv$auc)
threads <- as.numeric(argv$threads)
number <- as.numeric(argv$number)

if (!is.na(argv$outdir)) {
  outdir <- argv$outdir
}else if(endsWith(strsplit(exp_file,'/')[[1]][1],'_supp') & is.na(argv$outdir)) {
  outdir <- paste0(strsplit(exp_file,'/')[[1]][1],'/ROC/')
}else if(endsWith(strsplit(exp_file,'/')[[1]][2],'_supp') & is.na(argv$outdir)) {
  outdir <- paste0(strsplit(exp_file,'/')[[1]][2],'/ROC/')
}else{outdir <- './supp/ROC/'}

suppressPackageStartupMessages({
library(pROC)
library(ggplot2)
library(foreach)
library(doParallel)
})


